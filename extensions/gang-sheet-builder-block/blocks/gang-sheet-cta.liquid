{% comment %}
  Lightweight, JS-free CTA linking to the full editor served via App Proxy
  (see [app_proxy] in shopify.app.toml). The heavy canvas editor never ships
  in this extension — it lives entirely on the proxied page.
{% endcomment %}
<div class="gsb-cta" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2 class="gsb-cta__heading">{{ block.settings.heading }}</h2>
  {% endif %}
  {% if block.settings.subheading != blank %}
    <p class="gsb-cta__subheading">{{ block.settings.subheading }}</p>
  {% endif %}
  <a class="gsb-cta__button" href="{{ shop.url }}/apps/gang-sheet-builder">
    {{ block.settings.button_label }}
  </a>
</div>

{% schema %}
{
  "name": "Gang Sheet Builder",
  "target": "section",
  "stylesheet": "gang-sheet-cta.css",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Design your own gang sheet"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Upload your artwork and arrange it on a print-ready sheet."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Build Your Gang Sheet"
    }
  ]
}
{% endschema %}
